/* FreshOps focused visual correction:
   - enlarges the decorative produce framing on the customer price sheet
   - prevents footer text from being clipped/covered
   - hides the produce-crate corner treatment
   - makes internal product icons easier to see
   No pricing/business logic is changed.
*/

/* ===== Customer-facing Price Sheet ===== */

.print-full-width {
  overflow: visible !important;
  isolation: isolate;
}

/* Keep actual sheet content above decorative photography. */
.print-full-width > div {
  position: relative;
  z-index: 2;
}

/* Decorative image base behavior. */
.print-full-width > img[src*="/products/decorative/"] {
  position: absolute !important;
  z-index: 1 !important;
  pointer-events: none !important;
  object-fit: contain !important;
  max-width: none !important;
}

/* The source PNGs contain a lot of white space, so they must render
   substantially larger than icon-size for the fruit/leaves to have impact. */

.print-full-width > img[src*="corner-orange-cluster"] {
  width: 430px !important;
  height: 430px !important;
  top: -92px !important;
  left: -96px !important;
}

.print-full-width > img[src*="corner-lemon-cluster"] {
  width: 430px !important;
  height: 430px !important;
  top: -92px !important;
  right: -96px !important;
}

.print-full-width > img[src*="corner-strawberry-cluster"] {
  width: 390px !important;
  height: 390px !important;
  bottom: -82px !important;
  left: -88px !important;
}

/* Prefer the newer corner photography rather than the crate treatment. */
.print-full-width > img[src*="corner-produce-crate"],
.print-full-width > img[src*="corner-product-crate"] {
  display: none !important;
}

/* Footer always stays above decorative art. */
.print-full-width > div:last-child {
  position: relative !important;
  z-index: 5 !important;
  min-height: 52px;
  padding: 12px 24px !important;
  overflow: visible !important;
  flex-wrap: wrap;
  gap: 10px;
}

/* ===== Internal FreshOps commodity icons ===== */

/* ProductIcon already exists in the repo and points to /products/singles/.
   Make those images noticeable but still compact. */
img[src*="/products/singles/"] {
  width: 26px !important;
  height: 26px !important;
  min-width: 26px !important;
  min-height: 26px !important;
  object-fit: contain !important;
  flex-shrink: 0 !important;
}

/* ===== Mobile ===== */

@media (max-width: 767px) {
  .print-full-width > img[src*="corner-orange-cluster"] {
    width: 230px !important;
    height: 230px !important;
    top: -58px !important;
    left: -70px !important;
  }

  .print-full-width > img[src*="corner-lemon-cluster"] {
    width: 230px !important;
    height: 230px !important;
    top: -58px !important;
    right: -70px !important;
  }

  .print-full-width > img[src*="corner-strawberry-cluster"] {
    width: 210px !important;
    height: 210px !important;
    bottom: -45px !important;
    left: -64px !important;
  }

  .print-full-width > div:last-child {
    padding-left: 18px !important;
    padding-right: 18px !important;
  }

  img[src*="/products/singles/"] {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
  }
}

/* ===== Print / PDF ===== */

@media print {
  .print-full-width {
    overflow: hidden !important;
  }

  .print-full-width > img[src*="corner-orange-cluster"],
  .print-full-width > img[src*="corner-lemon-cluster"] {
    width: 330px !important;
    height: 330px !important;
    top: -78px !important;
  }

  .print-full-width > img[src*="corner-orange-cluster"] {
    left: -88px !important;
  }

  .print-full-width > img[src*="corner-lemon-cluster"] {
    right: -88px !important;
  }

  .print-full-width > img[src*="corner-strawberry-cluster"] {
    width: 290px !important;
    height: 290px !important;
    bottom: -66px !important;
    left: -76px !important;
  }

  .print-full-width > div:last-child {
    min-height: 48px;
  }
}
